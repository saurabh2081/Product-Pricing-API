	<secure-properties:config name="Secure_Properties_Config" doc:name="Secure Properties Config" doc:id="4431d167-b42e-4e45-a99e-9de883f4f25a" file="properties\app-${env}.secure.yaml" key="${mule.key}" />
	<global-property doc:name="Global Property" doc:id="97f0bd22-5366-4d44-a257-7b6c123b98e5" name="env" value="dev" />
	<global-property doc:name="Global Property" doc:id="64cfd641-32cf-48d5-b0b1-4a0a260163fd" name="mule.key" value="1234567891234567" />
	<http:request-config name="conversion_sapi_request_configuration" doc:name="HTTP Request configuration" doc:id="0a24392b-14cc-4b5c-ad20-23d5073fb0ce" responseTimeout="30000">
		<http:request-connection host="${secure::conversion-sapi.host}" protocol="HTTPS"/>
	</http:request-config>
	<http:request-config name="salesforce_sapi_request_configuration" doc:name="HTTP Request configuration" doc:id="28ffe19f-8ae7-4390-a087-32ee3b410e12" responseTimeout="30000">
		<http:request-connection protocol="HTTPS" host="${secure::salesforce-sapi.host}" />
	</http:request-config>
