    <apikit:config name="-product-pricing-papi-config" api="-product-pricing-papi.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
    <flow name="product-pricing-papi-main">
        <http:listener config-ref="product-pricing-papi-httpListenerConfig" path="/papi/v1/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:error-response>
        </http:listener>
		<apikit:router config-ref="-product-pricing-papi-config" />
        <error-handler ref="globalErrorHandler">
           
        </error-handler>
    </flow>
