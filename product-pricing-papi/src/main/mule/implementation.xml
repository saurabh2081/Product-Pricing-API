<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:os="http://www.mulesoft.org/schema/mule/os" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">
	<flow name="getProductsByCurrencyCode">
    
    <logger level="INFO" doc:name="flow start" doc:id="9b49b330-ed57-4830-aaad-c9992590817e" message='"product-pricing-papi - started" ' />
		<ee:transform doc:name='set queryParam variables' doc:id="af23aeb1-4259-449c-83c8-4984d7501532" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="setLimit" ><![CDATA[%dw 2.0
output application/json
---
attributes.queryParams.limit default "10"]]></ee:set-variable>
				<ee:set-variable variableName="setOffset" ><![CDATA[%dw 2.0
output application/json
---
attributes.queryParams.offset default "0"]]></ee:set-variable>
				<ee:set-variable variableName="targetCurrency" ><![CDATA[%dw 2.0
output application/json
---
upper(attributes.queryParams.targetCurrency) default "USD"]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<scatter-gather doc:name="Scatter-Gather" doc:id="b435fb10-9167-4019-8234-5f5b5659321f" >
			<route >
				<until-successful maxRetries="5" doc:name="Until Successful" doc:id="05be9098-c7e1-4c45-8659-faecea2e5d65" >
					<http:request method="${secure::salesforce-sapi.method}" doc:name="calling salesforce api" doc:id="557f27bb-d98e-4eeb-8b1e-61b3c8c824cc" config-ref="salesforce_sapi_request_configuration" path="${secure::salesforce-sapi.path}">
			<http:headers><![CDATA[#[{
	client_id: p('secure::auth.clientId'),
	client_secret: p('secure::auth.clientSecret')
}]]]></http:headers>
		</http:request>
				</until-successful>
				<logger level="DEBUG" doc:name="Logger" doc:id="b4648e14-8bf3-47ab-b43e-ab083dd8d558" message='"response from salesforce-product-sapi" #[payload]' />
				<ee:transform doc:name="salesforceAPI response" doc:id="eabe916d-8de5-42f8-9055-ee44e594f906" >
					<ee:message >
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="salesRespPayload" ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</route>
			<route>
				<until-successful maxRetries="5" doc:name="Until Successful" doc:id="dc972ee4-b87e-47e7-b3aa-c640d26b9684" >
					<http:request method="${secure::conversion-sapi.method}" doc:name="calling conversion sapi" config-ref="conversion_sapi_request_configuration" path="${secure::conversion-sapi.path}">
                <http:headers><![CDATA[#[{
	client_id: p('secure::auth.clientId'),
	client_secret: p('secure::auth.clientSecret')
}]]]></http:headers>
					<http:query-params><![CDATA[#[{ "to": vars.targetCurrency }]]]></http:query-params>
            </http:request>
				</until-successful>
				<logger level="DEBUG" doc:name="Logger" doc:id="792f94d6-fcf2-4ea5-b65e-2e482453df72" message='"response from currency-consversion-sapi" #[payload]' />
				<ee:transform doc:name="exchangeValue variable" doc:id="db9f204b-34ac-4907-9f21-654bf1d46fcd">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="exchangeValue"><![CDATA[%dw 2.0
output application/json
---
payload.rates[vars.targetCurrency] as Number default 1]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
			</route>
		</scatter-gather>
		<ee:transform doc:name="Currency conversion Logic">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json

---
vars.salesRespPayload   map ((item, index) -> item update {
    case price at .ProductPrice__c -> if(price != null) (price * vars.exchangeValue) as String {format: "0.00"} else null

    case code at .CurrencyCode__c -> if(code != null) vars.targetCurrency else null
}
)
]]></ee:set-payload>
            </ee:message>
        </ee:transform>
		<ee:transform doc:name="pagination" doc:id="c9da5511-2417-4a94-a1b1-41ffd7968ed4" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json

// 1. Capture Limit and Offset headers
var limit = (vars.setLimit default 10) as Number
var offset = (vars.setOffset default 0) as Number

// 2. Calculate boundaries for DataWeave slicing
// Start is the offset itself. End is start + limit - 1
var startIndex = offset
var endIndex = offset + limit - 1

// 3. Total count for metadata
var totalItems = sizeOf(payload default [])
---
{
    "metadata": {
        "total_records": totalItems,
        "limit": limit,
        "offset": offset,
        // Calculate current "page" just for information
        "estimated_page": floor(offset / limit) + 1,
        "has_more": endIndex < (totalItems - 1)
    },
    // 4. Slice the actual data
    "Products": payload[startIndex to endIndex] default []
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="flow end" doc:id="fcd0f1be-171d-4d24-bf29-40c349842741" message='"product-pricing-papi - end" '/>
</flow>
</mule>
