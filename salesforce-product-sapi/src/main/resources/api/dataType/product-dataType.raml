#%RAML 1.0 DataType
type: array
items:
  type: object
  properties:  
    externalId:
      type: string
      maxLength: 12
      required: false
      example: "P00000000001"
    name:
      type: string
      required: true
      example: "Cloud Widget"
    productCode:
      type: string
      required: true
      example: "XYZ12345"
    description:
      type: string
      required: false
      example: "High-performance cloud processing unit."
    currencyCode:
      type: string
      required: false
      default: "USD"
      example: "INR"
    productPrice:
      type: number
      required: true
      minimum: 0
      multipleOf: 0.01
      example: 1500.50
 
  