    <flow name="delete:\products:salesforce-product-sapi-config">
		<flow-ref doc:name="goto delete flow" doc:id="cb09aa77-e146-42c1-b3e1-153fe93794b0" name="deleteProductFlow"/>
    </flow>
    <flow name="patch:\products:application\json:salesforce-product-sapi-config">
		<flow-ref doc:name="goto update flow" doc:id="b6dc5d4f-80e9-42fb-8426-1ac2c9b676f0" name="updateProductsFlow"/>
    </flow>
    <flow name="get:\products:salesforce-product-sapi-config">
		<choice doc:name="Choice" doc:id="c14b2ee7-34f9-4c85-8fc7-aa84b4928265" >
			<when expression="#[attributes.queryParams.'externalId' != null]">
				<flow-ref doc:name="goto get flow" doc:id="5fa5f55b-599f-43d1-bb53-e177bf5d36ca" name="getSingleProductFlow"/>
			</when>
			<otherwise >
				<flow-ref doc:name="goto getAll flow" doc:id="580b1412-273c-47c2-9c7a-568f9626cd3d" name="getAllProductsFlow" />
			</otherwise>
		</choice>
    </flow>
    <flow name="post:\products:application\json:salesforce-product-sapi-config">
		<flow-ref doc:name="goto create flow" doc:id="071c95ac-f914-403d-b180-70ea74894330" name="createProductFlow"/>
