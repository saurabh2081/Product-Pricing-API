#%RAML 1.0 DataType
type: array
minItems: 1
uniqueItems: true
items:
  additionalProperties: false
  type: object
  properties:
    externalId:
      type: string
      maxLength: 12
      required: false
      example: "P00000000001"
    name:
      type: string
      required: true
      example: "Cloud Widget"
    productCode:
      type: string
      maxLength: 8
      required: true     
      example: "XYZ12345"
    description:
      type: string
      required: false
      example: "High-performance cloud processing unit."
    currencyCode:
      type: string
      maxLength: 3
      required: false
      default: "USD"
      example: "INR"
    productPrice:
      type: number
      required: true
      minimum: 0
      multipleOf: 0.01
      example: 1500.50
    isActive:
      type: boolean
      required: false
      example: true