<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">
	<error-handler name="globalErrorHandler">
    <on-error-propagate type="APIKIT:BAD_REQUEST" enableNotifications="true" logException="true">
        <ee:transform doc:name="400 Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "status": 400,
    "message": "Bad Request",
    "description": error.description default "The request sent by the client was syntactically incorrect." ,
    "apiName": "product-pricing-eapi"
}]]></ee:set-payload>
            </ee:message>
            <ee:variables>
                <ee:set-variable variableName="httpStatus"><![CDATA[400]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
    </on-error-propagate>

    <on-error-propagate type="ANY" when='#[error.errorType.identifier == "INVALID_CREDENTIALS" or (error.description contains "401")]'>
    <ee:transform doc:name="401 Response">
        <ee:message>
            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "status": 401,
    "message": "Unauthorized",
    "description": "Authentication failed. Check your username, password, or security token." ,
    "apiName": "product-pricing-eapi"
}]]></ee:set-payload>
        </ee:message>
        <ee:variables>
            <ee:set-variable variableName="httpStatus"><![CDATA[401]]></ee:set-variable>
        </ee:variables>
    </ee:transform>
</on-error-propagate>

    <on-error-propagate type="APIKIT:NOT_FOUND" enableNotifications="true" logException="true">
        <ee:transform doc:name="404 Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "status": 404,
    "message": "Resource Not Found",
    "description": "The requested product or endpoint does not exist." ,
    "apiName": "product-pricing-eapi"
}]]></ee:set-payload>
            </ee:message>
            <ee:variables>
                <ee:set-variable variableName="httpStatus"><![CDATA[404]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
    </on-error-propagate>

    <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED" enableNotifications="true" logException="true">
        <ee:transform doc:name="405 Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "status": 405,
    "message": "Method Not Allowed",
    "description": "The HTTP method is not supported for this endpoint." ,
    "apiName": "product-pricing-eapi"
}]]></ee:set-payload>
            </ee:message>
            <ee:variables>
                <ee:set-variable variableName="httpStatus"><![CDATA[405]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
    </on-error-propagate>
    
    <on-error-propagate type="CONNECTIVITY" doc:name="On Error Propagate - Connectivity">
    <ee:transform doc:name="Set 503 Response" doc:id="f60a09dd-e3f7-4482-812e-272e94302a78">
        <ee:message>
            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ 
    "message": "Service Unavailable", 
    "details": error.description default "Could not connect to Salesforce. Please try again later." ,
    "apiName": "product-pricing-eapi" 
}]]></ee:set-payload>
        </ee:message>
        <ee:variables>
            <ee:set-variable variableName="httpStatus"><![CDATA[503]]></ee:set-variable>
        </ee:variables>
    </ee:transform>
</on-error-propagate>
<on-error-propagate type="ANY" doc:name="On Error Propagate " enableNotifications="true" logException="true">
    <ee:transform doc:name="Set 500 Response" doc:id="1b8db866-4c6e-4ef1-ad7c-31e784ad5322">
        <ee:message>
            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ 
    "message": "Internal Server Error", 
    "details": error.description default "Could not connect to service. Please try again later." ,
    "apiName": "product-pricing-eapi"
}]]></ee:set-payload>
        </ee:message>
        <ee:variables>
            <ee:set-variable variableName="httpStatus"><![CDATA[500]]></ee:set-variable>
        </ee:variables>
    </ee:transform>
</on-error-propagate>

</error-handler>
	
	
	
	</mule>
