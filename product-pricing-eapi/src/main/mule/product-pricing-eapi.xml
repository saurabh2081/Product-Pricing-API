    <flow name="delete:\admin\products:product-pricing-eapi-config">
		<flow-ref doc:name="goto deleteproduct flow" doc:id="4d7437a4-5753-4d07-a17e-7b746de26262" name="deleteProductFlow"/>
    </flow>
    <flow name="patch:\admin\products:application\json:product-pricing-eapi-config">
		<flow-ref doc:name="goto updateproduct flow" doc:id="b8df23a7-7a9c-4329-9d65-6a4e36e3b6e9" name="updateProductFlow"/>
    </flow>
    <flow name="get:\inventory:product-pricing-eapi-config">
