    <apikit:config name="currency-conversion-sapi--config" api="currency-conversion-sapi-.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
    <flow name="currency-conversion-sapi--main" doc:id="868da733-7a85-4ffe-b534-6cef1f22edf9">
        <http:listener config-ref="currency-conversion-sapi--httpListenerConfig" path="/sapi/v1/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:error-response>
        </http:listener>
		<apikit:router config-ref="currency-conversion-sapi--config" />
		<error-handler ref="globalErrorHandler">
           
        </error-handler>
    </flow>
